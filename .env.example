# Copier ce fichier en .env (ignoré par Git) et adapter. Ne jamais committer de clé.

# Ollama local
OLLAMA_HOST=localhost:11434
# qwen3:4b = version « thinking » (lente, raisonne toujours) : prendre la version instruct
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT=600
# 4096 suffit pour 5 passages de 300 mots et accélère un portable sans GPU
OLLAMA_NUM_CTX=8192

# Coût par million de tokens, pour comparer avec un modèle API (0 en local).
# Inutile pour le backend agent_tools via OpenRouter : le coût réel est renvoyé par l'API.
COST_EUR_PER_MTOK_IN=0
COST_EUR_PER_MTOK_OUT=0

# Clé OpenRouter (backend agent_tools) : https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Surcharges facultatives de configs/*.yaml (préfixe HLM_, `__` pour descendre) :
# HLM_AGENT__BACKEND=ollama
# HLM_AGENT__BACKENDS__OPENROUTER__MODEL=openai/gpt-4.1-mini

# Clés API éventuelles (fournies par l'école) : uniquement dans .env
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
